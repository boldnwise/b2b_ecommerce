# =============================================================================
# B2B Marketplace API — Production environment template
# =============================================================================
# Copy to .env for local development, or set each variable in Render → Environment.
# Never commit real secrets. Never commit .env to git.
# =============================================================================

# ─── Required (app will not start in production without these) ───────────────

# PostgreSQL connection string (Neon recommended).
# Use the *pooled* host (-pooler) for the running API. sslmode=require is required.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string for Prisma migrations & advisory locks (omit -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT signing secret — min 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Allowed browser origins for CORS + cookies (comma-separated, no trailing slash).
# REQUIRED when NODE_ENV=production. Must match the browser Origin exactly.
#
# Primary production frontend:
CLIENT_URL="https://git-repo-gilt.vercel.app"
#
# Optional extra origins / Vercel preview deployments (supports wildcards):
# CORS_ALLOWED_ORIGINS="https://git-repo-gilt.vercel.app,https://git-repo-*.vercel.app"
#
# Optional override for Access-Control-Allow-Headers (comma-separated).
# Default includes Content-Type, Authorization, Accept, Cache-Control, X-Requested-With.
# CORS_ALLOWED_HEADERS="Content-Type,Authorization,Accept,Cache-Control,X-Requested-With"

# Must be "production" on Render / AWS API runtime.
NODE_ENV="production"

# Deployment tier when NODE_ENV=production:
#   production (default if APP_ENV is omitted) — live deploy; same cookie/CORS rules as below.
#   staging — pre-live API host; set explicitly:
# APP_ENV="staging"
#
# Razorpay startup (NODE_ENV=production):
#   APP_ENV=production (or omitted): API will NOT start without valid live credentials —
#     RAZORPAY_KEY_ID (rzp_live_*), RAZORPAY_KEY_SECRET, and RAZORPAY_WEBHOOK_SECRET.
#   APP_ENV=staging: API may start with Razorpay vars unset; subscription checkout returns
#     503 RAZORPAY_NOT_CONFIGURED until RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are set.
#     If you configure rzp_test_* keys on staging, checkout may use Razorpay test mode.
#     Webhooks require RAZORPAY_WEBHOOK_SECRET; without it, requests keep the existing
#     unavailable response (503 WEBHOOK_NOT_CONFIGURED).

# ─── Razorpay (required at startup for live production only; see APP_ENV above) ─

# Razorpay — https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_live_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME_LIVE_SECRET"
# Webhook signing secret from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET="REPLACE_ME_WEBHOOK_SECRET"

# Integration API (disabled in production unless explicitly enabled)
# INTEGRATION_API_ENABLED=false
# INTEGRATION_NEGOTIATION_VERIFY_URL=""
# INTEGRATION_S2S_SHARED_SECRET=""
# INTEGRATION_ALLOW_DEV_NEGOTIATION_STUB=false

# CSRF protection for cookie auth (default: true)
# CSRF_PROTECTION_ENABLED=true

# Public self-service registration (POST /api/auth/register).
# Production default: disabled unless set to true. Non-production default: enabled.
# ENABLE_PUBLIC_REGISTRATION=false

# Optional error monitoring (Sentry)
# SENTRY_DSN=""

# ─── RFQ attachments (default: local disk for development) ───────────────────
#
# RFQ_STORAGE_DRIVER=local   — files under server/uploads/rfq/ (default)
# RFQ_STORAGE_DRIVER=s3      — private S3 bucket; EC2 instance profile / IAM role (no static keys)
#
# Required when RFQ_STORAGE_DRIVER=s3:
# RFQ_S3_BUCKET="your-private-bucket-name"
# AWS_REGION="ap-south-1"
# Optional key prefix (default rfq/):
# RFQ_S3_PREFIX="rfq/"
#
# Downloads stay on the API (/api/quote-requests/attachments/file/:filename); objects are not public.

# ─── Optional (sensible defaults exist) ───────────────────────────────────────

# Render sets PORT automatically; default 3001 if unset.
PORT=3001

# JWT lifetime for auth cookies (also drives cookie maxAge). Default: 7d
# Formats: 7d, 24h, 3600s
JWT_EXPIRES_IN="7d"

# ─── Render / Docker build & release (not read by env.js at runtime) ─────────

# Run once after deploy (Render build command or manual shell):
#   npx prisma generate
#   npx prisma migrate deploy
#   node src/db/migrate.js
# Optional first-time data:
#   node prisma/seed.js
#   node src/db/migrate.js --seed

# Docker entrypoint only — do not set on Render unless using docker-entrypoint.sh
# SEED_DB=false

# Prisma optional — add to schema.prisma if migrate deploy fails via pooler:
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
